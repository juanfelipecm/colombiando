---
// Import the video asset
import footerVideo from '../assets/videos/colombiando-escuela-rural.mp4';
---

<footer>		
    <div class="flex flex-col lg:flex-row min-h-96 gap-y-10 lg:items-center">
        <div class="flex flex-1 items-center gap-2 justify-center mt-20 md:mt-0">
            <img src="/logo-ColombiAndo.png" alt="ColombiAndo logo" class="h-12 w-auto" />
        </div>
        <div class="flex flex-1 flex-col gap-2 justify-start border-x-2 border-white lg:border-black px-10 h-52">
            <h5 class="text-xl font-bold mt-8">Una plataforma de profes para profes</h5>
            <p class="text-sm">Somos una comunidad de profesores multigrado que se apoya, se conecta, comparte buenas prácticas y visibiliza la educación rural.</p>
        </div>
        <div class="flex flex-1 flex-col justify-start gap-2 px-10 h-52">
            <h5 class="text-xl mt-8 font-bold">Información de contacto</h5>
            <p class="text-sm">hola@colombiando.co</p>
            <div class="flex gap-4 mt-2">
                <a href="https://instagram.com/colombiandoporcolombia/" target="_blank" rel="noopener noreferrer" class="text-2xl">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="https://www.linkedin.com/company/colombiando/" target="_blank" rel="noopener noreferrer" class="text-2xl">
                    <i class="fab fa-linkedin"></i>
                </a>
            </div>
            <div class="flex flex-col gap-2 ">
                <a href="/documentos" rel="noopener noreferrer" class="text-sm underline">Información RTE</a>
            </div>
            <!-- <div class="flex flex-col gap-2"> -->
                <!-- <a href="https://colombiando.co" target="_blank" rel="noopener noreferrer" class="text-sm underline">Política de privacidad</a> -->
            <!-- </div> -->
        </div>
        <div class="flex flex-1 flex-col gap-2 min-h-64 lg:h-96">
            <!-- Mobile: Image with overlay, Desktop: Video with overlay -->
            <div class="relative lg:h-full lg:min-h-[24rem] w-full bg-gray-200">
                <!-- Mobile background image -->
                <img 
                    id="mobile-background"
                    src="/colombiando-salon-rural-min.jpeg" 
                    alt="Colombiando classroom" 
                    class="block lg:hidden h-96 w-full object-cover"
                />
                
                <!-- Desktop fallback image (hidden by default, shown when video fails) -->
                <img 
                    id="desktop-background-fallback"
                    src="/colombiando-salon-rural-min.jpeg" 
                    alt="Colombiando classroom" 
                    class="hidden lg:block h-full w-full object-cover absolute inset-0 bg-colombiando-blue z-0"
                    style="display: none;"
                />
                
                <!-- Desktop video -->
                <video 
                    id="footer-video"
                    class="hidden lg:block h-full w-full object-cover absolute inset-0 z-0" 
                    autoplay 
                    muted 
                    loop 
                    playsinline
                    preload="metadata"
                    webkit-playsinline
                    x-webkit-airplay="allow"
                    disablepictureinpicture
                    controls={false}
                >
                    <source src={footerVideo} type="video/mp4">
                    <!-- Fallback for browsers that don't support video -->
                    Your browser does not support the video tag.
                </video>
                
                <div class="flex flex-col gap-2 items-center absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-10">
                    <img src="/colombiando-logo.gif" alt="Colombiando logo" class="w-[60%] h-[60%]" />
                    <img src="/colombiando-logo-blanco.png" alt="Colombiando logo" class="w-[90%] h-[60%]" />
                </div>
            </div>    
            </div>
        </div>
    </div>
</footer>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const video = document.getElementById('footer-video') as HTMLVideoElement | null;
    const mobileImg = document.getElementById('mobile-background') as HTMLImageElement | null;
    
    console.log('Screen width:', window.innerWidth);
    console.log('Mobile image element:', mobileImg);
    if (mobileImg) {
        console.log('Mobile image src:', mobileImg.src);
        console.log('Mobile image classes:', mobileImg.className);
        console.log('Mobile image display style:', window.getComputedStyle(mobileImg).display);
    }
    
    if (video) {
        console.log('Video element found:', video);
        console.log('Video src attribute:', video.getAttribute('src'));
        console.log('Video sources:', video.querySelectorAll('source'));
        
        // Log the resolved source URL
        const sourceElement = video.querySelector('source');
        if (sourceElement) {
            console.log('Source src:', sourceElement.src);
            console.log('Source type:', sourceElement.type);
        }
        // Handle video load errors
        video.addEventListener('error', function(e) {
            console.error('Video failed to load. Error details:', e);
            console.error('Video error code:', video.error?.code);
            console.error('Video error message:', video.error?.message);
            console.error('Video src:', video.src || video.currentSrc);
            
            // Show fallback image when video fails
            const fallbackImg = document.getElementById('desktop-background-fallback');
            if (fallbackImg) {
                video.style.display = 'none';
                fallbackImg.style.display = 'block';
                console.log('Switched to fallback image on desktop');
            }
        });
        
        // Handle cases where video doesn't start playing
        video.addEventListener('loadstart', function() {
            console.log('Video loading started');
        });
        
        // Try to play the video (Safari sometimes needs explicit play call)
        video.addEventListener('canplay', function() {
            video.play().catch(function(error) {
                console.log('Autoplay prevented:', error);
            });
        });
    }
});
</script>
