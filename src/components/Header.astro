---
import Button from './Button.astro';
import { getLangFromUrl, type Language } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

// Helper function to check if a path is active
const isActive = (path: string) => {
  if (path === `/${lang}/` || path === `/${lang}`) {
    return currentPath === `/${lang}/` || currentPath === `/${lang}`;
  }
  return currentPath.includes(path);
};

// Get the current route without language prefix for language switching
const getCurrentRoute = () => {
  const parts = currentPath.split('/').filter(Boolean);
  if (parts.length > 1 && (parts[0] === 'es' || parts[0] === 'en')) {
    return parts.slice(1).join('/');
  }
  return '';
};

const currentRoute = getCurrentRoute();

// Generate alternate language URL
const alternateLang: Language = lang === 'es' ? 'en' : 'es';
const alternateUrl = currentRoute ? `/${alternateLang}/${currentRoute}` : `/${alternateLang}/`;
---

<header class="fixed top-0 left-0 right-0 z-100 flex items-center justify-between bg-white rounded-lg px-6 py-3 mx-2 md:mx-8 mt-2 md:mt-4 shadow-lg">
  <div class="flex items-center gap-2">
    <a href="/">
      <img src="/logo-ColombiAndo.png" alt="ColombiAndo logo" class="h-10 w-auto md:h-14" />
    </a>
  </div>
  
  <!-- Mobile menu button -->
  <button id="mobile-menu-toggle" class="md:hidden focus:outline-none" aria-label="Toggle menu">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
  
  <!-- Desktop Navigation -->
  <nav class="hidden md:flex flex-grow gap-4 border-b-4 border-black justify-end ml-6 pb-4 items-center">
    <a href={`/${lang}/`}>
      <Button variant="yellow" active={isActive(`/${lang}/`)}>{t('nav.home')}</Button>
    </a>
    <a href={`/${lang}/${lang === 'es' ? 'proyectos' : 'proyectos'}`}>
      <Button variant="blue" active={isActive('proyectos')}>{t('nav.projects')}</Button>
    </a>
    <a href={`/${lang}/${lang === 'es' ? 'nosotras' : 'nosotras'}`}>
      <Button variant="red" active={isActive('nosotras')}>{t('nav.about')}</Button>
    </a>
    <a href={`/${lang}/${lang === 'es' ? 'sumate' : 'sumate'}`}>
      <Button variant="white" active={isActive('sumate')}>{t('nav.joinUs')}</Button>
    </a>
  </nav>
  
  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="fixed inset-0 z-20 bg-white transform translate-x-full transition-transform duration-300 ease-in-out md:hidden">
    <div class="flex justify-between items-center p-6 border-b">
      <img src="/logo-ColombiAndo.png" alt="ColombiAndo logo" class="h-10 w-auto" />
      <button id="mobile-menu-close" class="focus:outline-none" aria-label="Close menu">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="flex flex-col items-center gap-6 p-8">
      <a href={`/${lang}/`} class="w-full max-w-xs text-center">
        <Button variant="yellow" active={isActive(`/${lang}/`)} class="w-full">{t('nav.home')}</Button>
      </a>
      <a href={`/${lang}/${lang === 'es' ? 'proyectos' : 'proyectos'}`} class="w-full max-w-xs text-center">
        <Button variant="blue" active={isActive('proyectos')} class="w-full">{t('nav.projects')}</Button>
      </a>
      <a href={`/${lang}/${lang === 'es' ? 'nosotras' : 'nosotras'}`} class="w-full max-w-xs text-center">
        <Button variant="red" active={isActive('nosotras')} class="w-full">{t('nav.about')}</Button>
      </a>
      <a href={`/${lang}/${lang === 'es' ? 'sumate' : 'sumate'}`} class="w-full max-w-xs text-center">
        <Button variant="white" active={isActive('sumate')} class="w-full">{t('nav.joinUs')}</Button>
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle functionality
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuToggle?.addEventListener('click', () => {
      mobileMenu?.classList.remove('translate-x-full');
    });
    
    mobileMenuClose?.addEventListener('click', () => {
      mobileMenu?.classList.add('translate-x-full');
    });
    
    // Save language preference when switching
    const langSwitchers = document.querySelectorAll('.lang-switcher, a[href^="/es/"], a[href^="/en/"]');
    langSwitchers.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
        if (href) {
          const lang = href.startsWith('/es') ? 'es' : href.startsWith('/en') ? 'en' : null;
          if (lang) {
            localStorage.setItem('preferred-language', lang);
          }
        }
      });
    });
  });
</script>