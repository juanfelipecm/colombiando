---
interface Props {
  image: string;
  alt: string;
  variant?: 'red' | 'blue' | 'yellow';
}

const { image, alt, variant = 'red' } = Astro.props as Props;

// Define border color classes based on variant
const borderColorClass = {
  red: 'border-colombiando-red',
  blue: 'border-colombiando-blue',
  yellow: 'border-colombiando-yellow'
}[variant];
---

<div class={`bg-white rounded-lg shadow-md hover:shadow-xl transition-all duration-300 p-6 border-8 ${borderColorClass}`}>
    <img src={image} alt={alt} class="w-full h-full object-cover" />
</div>