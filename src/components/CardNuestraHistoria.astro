---
import ImageRecuadro from './ImageRecuadro.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  variant?: 'red' | 'blue' | 'yellow';
  ano: string;
  titulo: string;
  parrafo: string;
}

const { image, alt, variant = 'red', ano, titulo, parrafo } = Astro.props as Props;

// Define text color classes based on variant
const textColorClass = {
  red: 'text-colombiando-red',
  blue: 'text-colombiando-blue',
  yellow: 'text-colombiando-yellow'
}[variant];
---

<div class="flex flex-col gap-4 my-10 mr-4">
    <ImageRecuadro image={image} variant={variant} alt={alt} />
    <div class="flex flex-col gap-0.5">
        <h3 class={`text-xl font-bold ${textColorClass}`}>{ano}</h3>
        <h2 class={`text-4xl font-bold ${textColorClass}`}>{titulo}</h2>
        <p class="text-sm">
            {parrafo}
        </p> 
    </div>
</div>