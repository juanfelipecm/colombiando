---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import FlippableCard from '../../components/FlippableCard.astro';
import HoverSpeechBubble from '../../components/HoverSpeechBubble.astro';
import heroHomeImage from '../../assets/images/hero-home.jpg';
import salonRuralImage from '../../assets/images/colombiando-salon-rural.jpg';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
---

<Layout>
	<section
		class="relative w-full h-screen bg-cover bg-center flex items-end justify-end p-10 pb-20 lg:pb-0"
		style={`background-image: url(${heroHomeImage.src});`}
	>
		<h1
			class="m:10 mb-30 lg:mb-20 lg:m-28 text-white text-4xl md:text-6xl font-bold max-w-lg text-center lg:text-right drop-shadow-md drop-shadow-black"
		>
			{t('home.hero.title')}
		</h1>
	</section>

	<!-- Section de Profe a Profe -->
	<section class="bg-white">
		<div class="flex flex-col lg:flex-row mx-auto px-4 py-16 gap-8 max-w-6xl lg:items-center">
			<h2 class="text-2xl lg:text-4xl font-bold text-colombiando-blue lg:min-w-fit">{t('home.teacherToTeacher.title')}</h2>
			<div class="hidden lg:block w-[3px] flex-none bg-black h-24"></div>
			<p class="text-lg lg:text-xl">{t('home.teacherToTeacher.description')}</p>
		</div>
	</section>
	<Gallery />

	<!-- Section Quienes Somos -->
	<section class="bg-white">
		<div class="flex flex-col lg:flex-row mx-auto px-4 py-16 gap-8 max-w-6xl items-center">
			<div class="flex flex-col gap-4 max-w-lg">
				<h2 class="text-2xl lg:text-4xl font-bold text-colombiando-red 	lg:min-w-fit">{t('home.whoWeAre.title')}</h2>
				<p class="text-lg lg:text-xl">{t('home.whoWeAre.description')}</p>
			</div>
			<FlippableCard />
		</div>
	</section>	

	<!-- Intro Salón Rural -->
	<section class="bg-white">
		<div class="flex flex-col lg:flex-row mx-auto px-4 py-16 gap-8 max-w-6xl lg:items-center">
			<h2 class="text-2xl lg:text-4xl font-bold text-colombiando-blue flex-1 ">{t('home.ruralClassroom.title')}</h2>
			<div class="hidden lg:block w-[3px] flex-none bg-black h-24"></div>
			<p class="text-lg lg:text-xl flex-1">{t('home.ruralClassroom.description')}</p>
		</div>
	</section>

	<!-- Section Salon Rural -->
	<section class="pb-24 lg:pb-0 py-12 min-h-[125vh]" style={`background-image: url(${salonRuralImage.src}); background-size: cover; background-position: center;`}>
		<!-- Responsive Grid Container -->
		<div class="mx-4 sm:mx-8 md:mx-12 lg:mx-24 my-8 sm:my-16 md:my-24 lg:my-36">
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-8 md:gap-12 lg:gap-16">
				<div class="flex items-center justify-center p-2 mt-3 ml-2">
					<HoverSpeechBubble variant="red">{t('home.ruralClassroom.bubbles.1')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-4 mr-1">
					<HoverSpeechBubble variant="blue">{t('home.ruralClassroom.bubbles.2')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mt-6 ml-4">
					<HoverSpeechBubble variant="yellow">{t('home.ruralClassroom.bubbles.3')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-3 mr-2">
					<HoverSpeechBubble variant="red">{t('home.ruralClassroom.bubbles.4')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mt-2 ml-3">
					<HoverSpeechBubble variant="blue">{t('home.ruralClassroom.bubbles.5')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-5 ml-1">
					<HoverSpeechBubble variant="yellow">{t('home.ruralClassroom.bubbles.6')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mt-4 mr-3">
					<HoverSpeechBubble variant="red">{t('home.ruralClassroom.bubbles.7')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-2 ml-5">
					<HoverSpeechBubble variant="blue">{t('home.ruralClassroom.bubbles.8')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mt-3 mr-2">
					<HoverSpeechBubble variant="yellow">{t('home.ruralClassroom.bubbles.9')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-6 ml-3">
					<HoverSpeechBubble variant="red">{t('home.ruralClassroom.bubbles.10')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-6 ml-3">
					<HoverSpeechBubble variant="yellow">{t('home.ruralClassroom.bubbles.11')}</HoverSpeechBubble>
				</div>

				<div class="flex items-center justify-center p-2 mb-6 ml-3">
					<HoverSpeechBubble variant="blue">{t('home.ruralClassroom.bubbles.12')}</HoverSpeechBubble>
				</div>

				<div class="flex items-center justify-center p-2 mt-3 mr-2">
					<HoverSpeechBubble variant="red">{t('home.ruralClassroom.bubbles.13')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-6 ml-3">
					<HoverSpeechBubble variant="yellow">{t('home.ruralClassroom.bubbles.14')}</HoverSpeechBubble>
				</div>
				
				<div class="flex items-center justify-center p-2 mb-6 ml-3">
					<HoverSpeechBubble variant="blue">{t('home.ruralClassroom.bubbles.15')}</HoverSpeechBubble>
				</div>

				<div class="flex items-center justify-center p-2 mb-6 ml-3">
					<HoverSpeechBubble variant="red">{t('home.ruralClassroom.bubbles.16')}</HoverSpeechBubble>
				</div>				

			</div>
		</div>
	</section>

</Layout>

